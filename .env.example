# 카카오 디벨로퍼스 REST 키. 이 파일을 복사해 .env 로 저장합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:13001/auth/kakao/callback

# 로컬 MySQL. Docker Compose는 MYSQL_URL을 mysql 컨테이너로 덮어씁니다.
MYSQL_URL=jdbc:mysql://localhost:3306/gongspec?characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci
MYSQL_USER=gongspec
MYSQL_PASSWORD=gongspec
MYSQL_ROOT_PASSWORD=root

# 배포 시 32자 이상으로 바꿉니다. HTTPS면 COOKIE_SECURE=true, CORS는 프론트 공개 주소입니다.
JWT_SECRET=gongspec-local-dev-jwt-secret-key-32b
JWT_EXPIRE=7d
CORS_ORIGINS=http://localhost:13001,http://127.0.0.1:13001
COOKIE_SECURE=false

# 재정경제부 공공기관 채용정보(ALIO) Open API 인증키. 값은 .env 에만 넣습니다.
ALIO_SERVICE_KEY=
